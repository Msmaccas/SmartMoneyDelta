{
  "name": "smart-money-delta",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "smart-money-delta",
      "version": "0.1.0",
      "hasInstallScript": true,
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {}
    },
    "node_modules/@smd/agents": {
      "resolved": "packages/agents",
      "link": true
    },
    "node_modules/@smd/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@smd/data": {
      "resolved": "packages/data",
      "link": true
    },
    "node_modules/@smd/providers": {
      "resolved": "packages/providers",
      "link": true
    },
    "node_modules/@smd/reports": {
      "resolved": "packages/reports",
      "link": true
    },
    "node_modules/@smd/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@smd/worker": {
      "resolved": "packages/worker",
      "link": true
    },
    "node_modules/@smd/workflows": {
      "resolved": "packages/workflows",
      "link": true
    },
    "packages/agents": {
      "name": "@smd/agents",
      "version": "0.1.0",
      "dependencies": {
        "@smd/core": "file:../core"
      }
    },
    "packages/core": {
      "name": "@smd/core",
      "version": "0.1.0"
    },
    "packages/data": {
      "name": "@smd/data",
      "version": "0.1.0",
      "dependencies": {
        "@smd/core": "file:../core"
      }
    },
    "packages/providers": {
      "name": "@smd/providers",
      "version": "0.1.0",
      "dependencies": {
        "@smd/core": "file:../core",
        "@smd/data": "file:../data"
      }
    },
    "packages/reports": {
      "name": "@smd/reports",
      "version": "0.1.0",
      "dependencies": {
        "@smd/core": "file:../core"
      }
    },
    "packages/server": {
      "name": "@smd/server",
      "version": "0.1.0",
      "dependencies": {
        "@smd/workflows": "file:../workflows"
      },
      "devDependencies": {}
    },
    "packages/worker": {
      "name": "@smd/worker",
      "version": "0.1.0",
      "dependencies": {
        "@smd/reports": "file:../reports",
        "@smd/workflows": "file:../workflows"
      }
    },
    "packages/workflows": {
      "name": "@smd/workflows",
      "version": "0.1.0",
      "dependencies": {
        "@smd/agents": "file:../agents",
        "@smd/core": "file:../core",
        "@smd/providers": "file:../providers"
      }
    }
  }
}
